digraph ACF {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.3", ranksep="0.38", fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#edf3fa", color="#477399", fontname="Arial", fontsize=12, margin="0.18,0.12"];
  edge [color="#477399", arrowsize=0.7, fontname="Arial", fontsize=10];
  input [label="Прибор: 64 бит × 2000 отсчётов/с"];
  prep [label="CPU: проверка данных и масштаба\nПреобразование в согласованный формат"];
  ring [label="Кольцо входа: 4096 отсчётов\nОбновить head; дождаться доступности GPU"];
  params [label="f = 1…500 Гц\nN + β = 2000/f; q + α = 500/f",fillcolor="#fff4dc"];
  product [label="500 независимых столбцов на GPU\np[j] = x[j] · ((1−α)x[j−q] + αx[j−q−1])"];
  direct [label="Основной вариант\nU = сумма N последних p\nПрямой расчёт каждого окна",fillcolor="#e6f4eb"];
  rec [label="Альтернатива\nU ← U + p[n] − p[n−N]\nПериодический пересчёт U",fillcolor="#fff4dc"];
  tail [label="A = (U + β·p[n−N]) / 2000\nДо прогрева: NaN"];
  matrix [label="Записать M[n mod 2000][f−1]\nМатрица: 2000 строк × 500 столбцов"];
  consumer [label="Событие готовности → потребитель\nЛогическая строка r: M[(n−r) mod 2000]\nНовая строка сверху; без физического сдвига"];
  input -> prep -> ring -> product;
  params -> product;
  product -> direct -> tail;
  product -> rec [style=dashed];
  rec -> tail [style=dashed];
  rec -> rec [style=dashed,label="U прошлого шага"];
  tail -> matrix -> consumer;
}
