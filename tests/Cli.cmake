set(input "${CMAKE_CURRENT_BINARY_DIR}/cli-input.txt")
file(WRITE "${input}" "1\n1\n1\n1\n1\n")
execute_process(COMMAND "${CLI}" INPUT_FILE "${input}" OUTPUT_VARIABLE output RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "CLI rejected valid input: ${result}")
endif()
string(REGEX MATCHALL "\n" rows "${output}")
list(LENGTH rows count)
if(NOT count EQUAL 5 OR NOT output MATCHES ",0\\.002[0-9]*\n$")
    message(FATAL_ERROR "Unexpected row count or f=500 constant response")
endif()
foreach(invalid IN ITEMS "1.1" "nan" "garbage")
    file(WRITE "${input}" "${invalid}\n")
    execute_process(COMMAND "${CLI}" INPUT_FILE "${input}" OUTPUT_QUIET ERROR_QUIET RESULT_VARIABLE result)
    if(NOT result EQUAL 1)
        message(FATAL_ERROR "CLI did not reject ${invalid}")
    endif()
endforeach()
file(WRITE "${input}" "9223372036854775808\n")
execute_process(COMMAND "${CLI}" --int64 INPUT_FILE "${input}" OUTPUT_QUIET ERROR_QUIET RESULT_VARIABLE result)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "CLI did not reject int64 overflow")
endif()
file(WRITE "${input}" "-9223372036854775808\n9223372036854775807\n")
execute_process(COMMAND "${CLI}" --int64 --recursive INPUT_FILE "${input}" OUTPUT_QUIET ERROR_QUIET RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "CLI rejected valid int64 limits")
endif()
file(REMOVE "${input}")
